---
import { t, url, formatDate, readingMinutes, type Lang } from '../i18n';
import { postPath, type Post } from '../lib/posts';
interface Props { lang: Lang; posts: Post[] }
const { lang, posts } = Astro.props;
const s = t[lang];
---
{posts.length === 0 ? (
  <p class="muted">{s.blog.empty}</p>
) : (
  <ul class="posts">
    {posts.map((p) => (
      <li>
        <a href={url(postPath(p))}>
          <span class="date">
            {formatDate(p.data.date, lang)} · {readingMinutes(p.body)} {s.blog.minRead}
            {p.data.draft && <span class="tag">draft</span>}
          </span>
          <span class="title">{p.data.title}</span>
          <span class="desc">{p.data.description}</span>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .posts { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
  .posts a {
    display: grid; gap: 4px; padding: 16px 18px; margin: 0 -18px;
    border-radius: var(--radius); color: var(--text);
  }
  .posts a:hover { background: var(--surface-2); text-decoration: none; }
  .date { font-size: 0.85rem; color: var(--faint); display: flex; gap: 8px; align-items: center; }
  .title { font-weight: 650; font-size: 1.1rem; line-height: 1.35; }
  .posts a:hover .title { color: var(--accent); }
  .desc { color: var(--muted); font-size: 0.97rem; }
  @media (max-width: 600px) { .posts a { margin: 0 -12px; padding: 14px 12px; } }
</style>
