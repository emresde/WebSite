---
import Icon from './Icon.astro';
import { t, profile, url, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap row">
    <ul class="social" aria-label={lang === 'tr' ? 'Sosyal medya' : 'Social links'}>
      {profile.social.map((x) => (
        <li><a href={x.href} rel="me noopener" target="_blank" aria-label={x.label} title={x.label}><Icon name={x.key} size={19} /></a></li>
      ))}
      <li><a href={`mailto:${profile.email}`} aria-label="E-mail" title={profile.email}><Icon name="mail" size={19} /></a></li>
    </ul>
    <p class="meta">
      © {year} {profile.name} · <a href={url('/cebimcepte-privacy.html')}>{s.footer.privacy}</a>
    </p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--border); padding: 28px 0 36px; }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .social { display: flex; gap: 4px; list-style: none; padding: 0; margin: 0 0 0 -8px; }
  .social a { display: inline-flex; padding: 8px; border-radius: 8px; color: var(--muted); }
  .social a:hover { color: var(--text); background: var(--surface-2); }
  .meta { margin: 0; font-size: 0.85rem; color: var(--faint); }
  .meta a { color: var(--muted); }
</style>
