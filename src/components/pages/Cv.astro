---
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import { t, url, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const first = lang === 'tr' ? 'tr' : 'en';
const files = { tr: url('/cv.pdf'), en: url('/cv_en.pdf') };
---
<Base lang={lang} current="cv" title={s.cv.title} description={s.cv.intro}>
  <div class="wrap">
    <h1>{s.cv.title}</h1>
    <p class="muted">{s.cv.intro}</p>
    <div class="bar">
      <div class="seg" role="group" aria-label={s.cv.title}>
        <button type="button" data-cv="tr" aria-pressed={first === 'tr' ? 'true' : 'false'}>{s.cv.viewTr}</button>
        <button type="button" data-cv="en" aria-pressed={first === 'en' ? 'true' : 'false'}>{s.cv.viewEn}</button>
      </div>
      <a class="btn btn-primary" id="cv-dl" href={files[first]} download><Icon name="download" size={16} /> {s.cv.download}</a>
    </div>
    <div class="frame card">
      <iframe id="cv-frame" src={files[first]} title={s.cv.title}></iframe>
    </div>
  </div>
</Base>
<script is:inline define:vars={{ files }}>
  const frame = document.getElementById('cv-frame');
  const dl = document.getElementById('cv-dl');
  document.querySelectorAll('[data-cv]').forEach((b) => {
    b.addEventListener('click', () => {
      const k = b.getAttribute('data-cv');
      frame.src = files[k]; dl.href = files[k];
      document.querySelectorAll('[data-cv]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    });
  });
</script>
<style>
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin: 24px 0 16px; }
  .seg { display: inline-flex; padding: 3px; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); }
  .seg button {
    border: 0; background: transparent; color: var(--muted); font: 600 0.9rem var(--font);
    padding: 7px 16px; border-radius: 999px; cursor: pointer;
  }
  .seg button[aria-pressed='true'] { background: var(--surface-2); color: var(--text); }
  .frame { padding: 0; overflow: hidden; height: min(80vh, 1000px); }
  .frame iframe { width: 100%; height: 100%; border: 0; display: block; background: #fff; }
  @media (max-width: 600px) { .frame { height: 70vh; } }
</style>
