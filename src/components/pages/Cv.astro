---
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import { t, profile, url, type Lang } from '../../i18n';
import { cv } from '../../cv';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const c = cv[lang];
const pdf = lang === 'tr' ? url('/cv.pdf') : url('/cv_en.pdf');
const otherPdf = lang === 'tr' ? url('/cv_en.pdf') : url('/cv.pdf');
---
<Base lang={lang} current="cv" title={s.cv.title} description={s.cv.intro}>
  <div class="wrap cv">
    <header class="cv-head">
      <p class="eyebrow">{s.cv.title}</p>
      <h1>{profile.name}</h1>
      <p class="subtitle grad-text">{c.subtitle}</p>
      <p class="contact">
        <span>{c.location}</span>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={pdf} download><Icon name="download" size={16} /> {s.cv.download}</a>
        <a class="other" href={otherPdf} download>{s.cv.otherPdf}</a>
      </div>
    </header>

    <section aria-labelledby="cv-summary">
      <h2 id="cv-summary" class="section-title">{c.headings.summary}</h2>
      {c.summary.map((p) => <p class="summary">{p}</p>)}
    </section>

    <section aria-labelledby="cv-exp">
      <h2 id="cv-exp" class="section-title">{c.headings.experience}</h2>
      <ol class="timeline">
        {c.experience.map((j) => (
          <li>
            <p class="when">{j.when} · {j.where}</p>
            <h3>{j.role}</h3>
            <p class="org">{j.org} <span class="team">· {j.team}</span></p>
            {j.link && <p class="link"><a href={j.link.href} target="_blank" rel="noopener">{j.link.label} ↗</a></p>}
            <ul class="bullets">{j.bullets.map((b) => <li>{b}</li>)}</ul>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="cv-proj">
      <h2 id="cv-proj" class="section-title">{c.headings.projects}</h2>
      <ul class="projects">
        {c.projects.map((p) => (
          <li>
            <h3>{p.name}</h3>
            <p class="tech">{p.tech}</p>
            <p class="text">{p.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="cv-skills">
      <h2 id="cv-skills" class="section-title">{c.headings.skills}</h2>
      <dl class="skills">
        {c.skills.map((g) => (<><dt>{g.group}</dt><dd>{g.items}</dd></>))}
      </dl>
    </section>

    <section class="two">
      <div>
        <h2 class="section-title">{c.headings.education}</h2>
        {c.education.map((e) => (
          <div class="entry">
            <p class="when">{e.when}</p>
            <h3>{e.school}</h3>
            <p class="text">{e.degree}</p>
          </div>
        ))}
      </div>
      <div>
        <h2 class="section-title">{c.headings.languages}</h2>
        <p class="text">{c.languages}</p>
      </div>
    </section>

    <section aria-labelledby="cv-awards">
      <h2 id="cv-awards" class="section-title">{c.headings.awards}</h2>
      {c.awards.map((a) => (
        <div class="entry">
          <p class="when">{a.when}</p>
          <h3>{a.title}</h3>
          <p class="text">{a.text}</p>
        </div>
      ))}
    </section>
  </div>
</Base>

<style>
  .cv-head { padding: 8px 0 4px; margin-bottom: 56px; }
  .eyebrow {
    margin: 0 0 6px; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--accent);
  }
  .cv-head h1 { margin-bottom: 4px; }
  .subtitle { font-weight: 650; font-size: 1.1rem; margin-bottom: 12px; width: fit-content; }
  .contact { display: flex; flex-wrap: wrap; gap: 4px 16px; color: var(--muted); font-size: 0.95rem; margin-bottom: 22px; }
  .actions { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .other { font-size: 0.92rem; font-weight: 600; }

  .summary { color: var(--muted); max-width: 66ch; }
  .text { color: var(--muted); margin: 0; font-size: 0.97rem; }
  .when { margin: 0 0 4px; color: var(--faint); font: 500 0.82rem var(--mono); font-variant-numeric: tabular-nums; }
  h3 { margin: 0; }

  .timeline { list-style: none; padding: 0 0 0 26px; margin: 0; display: grid; gap: 30px; position: relative; }
  .timeline::before {
    content: ""; position: absolute; left: 5px; top: 8px; bottom: 8px; width: 2px; border-radius: 2px;
    background: linear-gradient(to bottom, var(--accent), var(--accent-2) 60%, var(--border));
  }
  .timeline > li { position: relative; }
  .timeline > li::before {
    content: ""; position: absolute; left: -26px; top: 6px; width: 12px; height: 12px; border-radius: 50%;
    background: var(--bg); border: 2px solid var(--accent-2);
  }
  .timeline > li:first-child::before { background: var(--accent); border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .org { margin: 2px 0 0; color: var(--accent); font-weight: 600; font-size: 0.95rem; }
  .team { color: var(--muted); font-weight: 500; }
  .link { margin: 4px 0 0; font-size: 0.88rem; font-weight: 600; }
  .bullets { margin: 10px 0 0; padding-left: 1.1em; color: var(--muted); font-size: 0.96rem; }
  .bullets li + li { margin-top: 6px; }
  .bullets li::marker { color: var(--accent-2); }

  .projects { list-style: none; padding: 0; margin: 0; display: grid; gap: 22px; }
  .tech { margin: 3px 0 6px; font: 500 0.8rem var(--mono); color: var(--accent-2); }

  .skills { display: grid; grid-template-columns: max-content 1fr; gap: 10px 20px; margin: 0; }
  .skills dt { font-weight: 650; font-size: 0.95rem; }
  .skills dd { margin: 0; color: var(--muted); font-size: 0.95rem; }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; }
  .entry + .entry { margin-top: 18px; }

  @media (max-width: 600px) {
    .subtitle { font-size: 1rem; }
    .actions .btn { flex: 1; }
    .actions { gap: 12px 18px; }
    .cv-head { margin-bottom: 48px; }
    .skills { grid-template-columns: 1fr; gap: 2px; }
    .skills dd { margin-bottom: 10px; }
    .two { grid-template-columns: 1fr; gap: 48px; }
  }

  /* Yazdirirken sadece ozgecmis kalsin */
  @media print {
    :global(.site-header), :global(.site-footer), .actions, .eyebrow { display: none !important; }
    :global(main) { padding: 0 !important; }
    section + section { margin-top: 24px; }
  }
</style>
