---
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import PostList from '../PostList.astro';
import MazeIntro from '../MazeIntro.astro';
import { t, profile, routes, url, type Lang } from '../../i18n';
import { getPosts } from '../../lib/posts';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const posts = (await getPosts(lang)).slice(0, 3);
const now = s.experience[0];
const lessLabel = lang === 'tr' ? 'Daha az göster' : 'Show less';
---
<Base lang={lang} current="home">
  <MazeIntro lang={lang} />
  <div class="wrap">
    <section class="hero">
      <p class="now"><span class="dot" aria-hidden="true"></span><span class="now-label">{s.sections.now}</span> {now.title.split(',')[0]} · {now.org}</p>
      <p class="hello">{s.hero.greeting}</p>
      <h1>{profile.name}</h1>
      <p class="role grad-text">{s.hero.role}</p>
      <div class="bio-wrap" data-bio>
        <p class="bio" id="bio">{s.hero.bio}</p>
        <button class="bio-more" type="button" aria-controls="bio" aria-expanded="false" data-more={s.blog.readMore} data-less={lessLabel}>{s.blog.readMore}</button>
      </div>
      <div class="cta">
        <a class="btn btn-primary" href={url(routes.blog[lang])}>{s.hero.ctaBlog} <Icon name="arrow" size={16} /></a>
        <a class="btn" href={url(routes.cv[lang])}>{s.hero.ctaCv}</a>
      </div>
      <ul class="social">
        {profile.social.map((x) => (
          <li><a href={x.href} rel="me noopener" target="_blank" aria-label={x.label} title={x.label}><Icon name={x.key} size={20} /></a></li>
        ))}
      </ul>
      <button class="maze-replay" type="button" data-open-maze>&gt; {lang === 'tr' ? 'labirenti aç' : 'open the maze'}<span aria-hidden="true">_</span></button>
    </section>

    <section aria-labelledby="exp">
      <h2 id="exp" class="section-title">{s.sections.experience}</h2>
      <ol class="timeline">
        {s.experience.map((e) => (
          <li>
            <span class="when">{e.when}</span>
            <div>
              <h3>{e.title}</h3>
              <p class="org">{e.org}</p>
              <p class="text">{e.text}</p>
              {'link' in e && e.link && (
                <p class="exp-link"><a href={e.link.href} target="_blank" rel="noopener">{e.link.label} ↗</a></p>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="projeler" aria-labelledby="proj">
      <h2 id="proj" class="section-title">{s.sections.projects}</h2>
      <div class="grid">
        {s.projects.map((p) => (
          <article class="card project">
            <div class="head"><span class="tag">{p.tag}</span><h3>{p.name}</h3></div>
            <p>{p.text}</p>
            {p.link && (p.link.href
              ? <a class="more" href={url(p.link.href)}>{p.link.label} →</a>
              : <span class="more soon">{p.link.label}</span>)}
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="posts">
      <div class="title-row">
        <h2 id="posts" class="section-title">{s.sections.latest}</h2>
        <a class="all" href={url(routes.blog[lang])}>{s.sections.allPosts} →</a>
      </div>
      <PostList lang={lang} posts={posts} />
    </section>

    <section class="two" aria-label={`${s.sections.skills}, ${s.sections.awards}`}>
      <div>
        <h2 class="section-title">{s.sections.skills}</h2>
        <ul class="chips">{s.skills.map((k) => <li>{k}</li>)}</ul>
      </div>
      <div>
        <h2 class="section-title">{s.sections.awards}</h2>
        <ul class="awards">
          {s.awards.map((a) => <li class="card"><span class="when">{a.when}</span> {a.text}</li>)}
        </ul>
      </div>
    </section>
  </div>
</Base>

<script is:inline>
  (function () {
    var wrap = document.querySelector('[data-bio]');
    if (!wrap) return;
    var bio = wrap.querySelector('.bio');
    var btn = wrap.querySelector('.bio-more');
    // Metin zaten sigiyorsa dugmeyi gosterme.
    function check() {
      if (wrap.dataset.open === 'true') return;
      wrap.dataset.clamped = String(bio.scrollHeight > bio.clientHeight + 2);
    }
    btn.addEventListener('click', function () {
      var open = wrap.dataset.open !== 'true';
      wrap.dataset.open = String(open);
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? btn.dataset.less : btn.dataset.more;
    });
    check();
    window.addEventListener('resize', check);
  })();
</script>

<style>
  .hero { padding: 28px 0 8px; }
  .now {
    display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap;
    margin: 0 0 26px; padding: 6px 14px 6px 10px; border-radius: 999px;
    border: 1px solid var(--border); background: var(--surface);
    font-size: 0.85rem; color: var(--muted); line-height: 1.3;
  }
  .now-label { color: var(--text); font-weight: 650; }
  .dot {
    width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex: none;
    box-shadow: 0 0 0 4px var(--accent-soft);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse { 50% { box-shadow: 0 0 0 7px transparent; } }
  .hello { margin: 0 0 2px; color: var(--muted); font-weight: 550; }
  .hero h1 { margin-bottom: 6px; }
  .role { font-size: 1.2rem; font-weight: 650; margin-bottom: 18px; width: fit-content; }
  .bio { font-size: 1.06rem; color: var(--muted); max-width: 62ch; margin: 0; }
  .bio-more {
    display: none; margin-top: 6px; padding: 4px 0; border: 0; background: none; cursor: pointer;
    font: 600 0.92rem var(--font); color: var(--accent);
  }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; margin: 26px 0 20px; }
  .social { display: flex; gap: 2px; list-style: none; padding: 0; margin: 0 0 0 -10px; }
  .social a { display: inline-flex; padding: 10px; border-radius: 10px; color: var(--muted); }
  .social a:hover { color: var(--accent); background: var(--surface-2); }

  /* Zaman cizelgesi: solda gradyan cizgi, her is icin bir nokta */
  .timeline { list-style: none; padding: 0 0 0 26px; margin: 0; display: grid; gap: 28px; position: relative; }
  .timeline::before {
    content: ""; position: absolute; left: 5px; top: 8px; bottom: 8px; width: 2px; border-radius: 2px;
    background: linear-gradient(to bottom, var(--accent), var(--accent-2) 60%, var(--border));
  }
  .timeline li { position: relative; }
  .timeline li::before {
    content: ""; position: absolute; left: -26px; top: 6px; width: 12px; height: 12px; border-radius: 50%;
    background: var(--bg); border: 2px solid var(--accent-2);
  }
  .timeline li:first-child::before { background: var(--accent); border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .timeline .when {
    display: block; color: var(--faint); font: 500 0.82rem var(--mono); margin-bottom: 4px;
    font-variant-numeric: tabular-nums;
  }
  .timeline h3 { margin: 0; }
  .org { margin: 2px 0 8px; color: var(--accent); font-weight: 600; font-size: 0.95rem; }
  .timeline .text { margin: 0; color: var(--muted); font-size: 0.97rem; }
  .exp-link { margin: 8px 0 0; font-size: 0.9rem; font-weight: 600; }

  .grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .project { display: flex; flex-direction: column; transition: border-color .2s, transform .2s; }
  .project:hover { border-color: color-mix(in srgb, var(--accent-2) 55%, var(--border)); transform: translateY(-2px); }
  .project .head { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; margin-bottom: 10px; }
  .project .tag { color: var(--accent-2); background: color-mix(in srgb, var(--accent-2) 10%, transparent); border-color: color-mix(in srgb, var(--accent-2) 25%, transparent); }
  .project h3 { margin: 0; }
  .project p { color: var(--muted); font-size: 0.95rem; flex: 1; }
  .more { font-size: 0.9rem; font-weight: 600; }
  .soon { color: var(--faint); }

  .title-row { display: flex; align-items: baseline; justify-content: space-between; }
  .all { font-size: 0.9rem; font-weight: 600; }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; }
  .awards { list-style: none; padding: 0; margin: 0; color: var(--muted); font-size: 0.95rem; display: grid; gap: 10px; }
  .awards .card { padding: 14px 16px; }
  .awards .when { display: block; color: var(--accent); font-weight: 600; font-size: 0.82rem; margin-bottom: 2px; }

  @media (max-width: 600px) {
    .hero { padding-top: 12px; }
    .now { margin-bottom: 20px; font-size: 0.8rem; }
    .role { font-size: 1.08rem; }
    .bio { font-size: 1rem; }
    [data-bio]:not([data-open='true']) .bio {
      display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;
    }
    [data-bio][data-clamped='true'] .bio-more, [data-bio][data-open='true'] .bio-more { display: inline-block; }
    .cta .btn { flex: 1; }

    /* Projeler mobilde yana kaydirilan kartlar */
    .grid {
      display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px;
      margin: 0 -18px; padding: 2px 18px 10px; scroll-padding: 0 18px;
      scrollbar-width: none;
    }
    .grid::-webkit-scrollbar { display: none; }
    .project { flex: 0 0 84%; scroll-snap-align: start; }
    .project:hover { transform: none; }

    .two { grid-template-columns: 1fr; gap: 48px; }
    .chips li { font-size: 0.84rem; padding: 4px 11px; }
  }
  .maze-replay {
    margin-top: 18px; padding: 0; border: 0; background: none; cursor: pointer;
    font: 500 0.82rem var(--mono); color: var(--faint); letter-spacing: .02em;
  }
  .maze-replay:hover { color: var(--accent-2); }
  .maze-replay span { animation: replay-blink 1s steps(1) infinite; }
  @keyframes replay-blink { 50% { opacity: 0; } }
</style>
