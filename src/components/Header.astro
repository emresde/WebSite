---
import Icon from './Icon.astro';
import { t, routes, url, type Lang, type RouteKey } from '../i18n';
interface Props { lang: Lang; current?: RouteKey; altHref?: string }
const { lang, current, altHref } = Astro.props;
const s = t[lang];
const other: Lang = lang === 'tr' ? 'en' : 'tr';
const switchHref = altHref ?? url(routes[current ?? 'home'][other]);
const items: { key: RouteKey | 'projects'; label: string; href: string }[] = [
  { key: 'blog', label: s.nav.blog, href: url(routes.blog[lang]) },
  { key: 'projects', label: s.nav.projects, href: url(routes.home[lang]) + '#projeler' },
  { key: 'cv', label: s.nav.cv, href: url(routes.cv[lang]) },
  { key: 'contact', label: s.nav.contact, href: url(routes.contact[lang]) },
];
const menuLabel = lang === 'tr' ? 'Menüyü aç/kapat' : 'Toggle menu';
---
<header class="site-header" data-nav-open="false">
  <div class="wrap bar">
    <a class="brand" href={url(routes.home[lang])}>
      <span class="mark" aria-hidden="true">ED</span>
      <span>Emre Döşlü</span>
    </a>
    <nav id="site-nav" aria-label={lang === 'tr' ? 'Ana menü' : 'Main menu'}>
      <ul>
        {items.map((i) => (
          <li><a href={i.href} aria-current={current === i.key ? 'page' : undefined}>{i.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="tools">
      <a class="tool lang" href={switchHref} hreflang={other} lang={other}>{other.toUpperCase()}<span class="sr-only"> — {s.langSwitch}</span></a>
      <button class="tool theme" type="button" aria-label={s.themeToggle} data-theme-toggle>
        <span class="i-sun"><Icon name="sun" size={18} /></span>
        <span class="i-moon"><Icon name="moon" size={18} /></span>
      </button>
      <button class="tool menu" type="button" aria-label={menuLabel} aria-controls="site-nav" aria-expanded="false" data-menu-toggle>
        <span class="i-open"><Icon name="menu" size={20} /></span>
        <span class="i-close"><Icon name="close" size={20} /></span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.querySelector('.site-header');
    var btn = document.querySelector('[data-menu-toggle]');
    if (!header || !btn) return;
    function set(open) {
      header.dataset.navOpen = String(open);
      btn.setAttribute('aria-expanded', String(open));
    }
    btn.addEventListener('click', function () { set(header.dataset.navOpen !== 'true'); });
    header.querySelectorAll('nav a').forEach(function (a) { a.addEventListener('click', function () { set(false); }); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
  })();
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(160%) blur(12px);
    -webkit-backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .bar { display: flex; align-items: center; gap: 20px; height: 62px; }
  .brand {
    display: inline-flex; align-items: center; gap: 10px;
    font-weight: 700; letter-spacing: -0.01em; color: var(--text); white-space: nowrap;
  }
  .brand:hover { text-decoration: none; color: var(--text); }
  .mark {
    display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 8px;
    background: var(--btn-grad); color: #fff; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.02em;
  }
  nav { margin-left: auto; }
  nav ul { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  nav a {
    position: relative; display: block; padding: 7px 11px; border-radius: 8px; color: var(--muted);
    font-size: 0.94rem; font-weight: 550;
  }
  nav a:hover { color: var(--text); background: var(--surface-2); text-decoration: none; }
  nav a[aria-current='page'] { color: var(--text); }
  nav a[aria-current='page']::after {
    content: ""; position: absolute; left: 11px; right: 11px; bottom: 1px; height: 2px;
    border-radius: 2px; background: var(--grad);
  }
  .tools { display: flex; align-items: center; gap: 6px; }
  .tool {
    display: inline-flex; align-items: center; justify-content: center;
    height: 36px; min-width: 36px; padding: 0 9px; border-radius: 9px;
    border: 1px solid var(--border); background: var(--surface); color: var(--muted);
    font: 600 0.78rem var(--font); letter-spacing: 0.04em; cursor: pointer;
  }
  .tool:hover { color: var(--text); text-decoration: none; border-color: var(--border-strong); }
  .i-sun, .i-moon, .i-open, .i-close { display: inline-flex; align-items: center; }
  .i-moon, .i-close, .menu { display: none; }
  :global(:root[data-theme='dark']) .i-sun { display: none; }
  :global(:root[data-theme='dark']) .i-moon { display: inline-flex; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .i-sun { display: none; }
    :global(:root:not([data-theme='light'])) .i-moon { display: inline-flex; }
  }

  /* Mobil: tek satir ust bar + acilir menu */
  @media (max-width: 680px) {
    .bar { height: 58px; gap: 10px; }
    .tools { margin-left: auto; }
    .menu { display: inline-flex; }
    nav {
      position: absolute; top: 100%; left: 0; right: 0; margin: 0;
      background: var(--bg); border-bottom: 1px solid var(--border);
      padding: 8px 18px 14px;
      box-shadow: 0 16px 32px -16px rgba(0, 0, 0, 0.25);
      display: none;
    }
    .site-header[data-nav-open='true'] nav { display: block; }
    .site-header[data-nav-open='true'] .i-open { display: none; }
    .site-header[data-nav-open='true'] .i-close { display: inline-flex; }
    nav ul { flex-direction: column; gap: 2px; }
    nav a { padding: 12px 12px; font-size: 1.05rem; border-radius: 10px; }
    nav a[aria-current='page'] { background: var(--surface-2); }
    nav a[aria-current='page']::after { left: 0; right: auto; top: 12px; bottom: 12px; width: 3px; height: auto; }
  }
</style>
