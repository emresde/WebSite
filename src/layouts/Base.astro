---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, profile, url, type Lang, type RouteKey } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  current?: RouteKey;
  /** Dil dugmesinin gidecegi adres (ör. bir yazinin diger dildeki hali). */
  altHref?: string;
}
const { lang, title, description, current, altHref } = Astro.props;
const s = t[lang];
const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} — ${s.hero.role}`;
const desc = description ?? s.hero.bio;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1115" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Secilen temayi sayfa cizilmeden once uygula (yanip sonmeyi onler).
      try {
        var th = localStorage.getItem('theme');
        if (th === 'light' || th === 'dark') document.documentElement.dataset.theme = th;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#icerik">{s.skip}</a>
    <Header lang={lang} current={current} altHref={altHref} />
    <main id="icerik">
      <slot />
    </main>
    <Footer lang={lang} />
    <script is:inline>
      (function () {
        var btn = document.querySelector('[data-theme-toggle]');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var root = document.documentElement;
          var current = root.dataset.theme ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          var next = current === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
